[gd_scene load_steps=6 format=3]

[sub_resource type="Shader" id="Shader_portal"]
code = "shader_type spatial;
render_mode unshaded, blend_add, cull_disabled, depth_draw_never;

uniform vec4 color_core : source_color = vec4(0.85, 0.55, 1.0, 1.0);
uniform vec4 color_edge : source_color = vec4(0.3, 0.85, 0.95, 1.0);
uniform float swirl_speed : hint_range(0.0, 5.0) = 1.2;
uniform float ring_speed : hint_range(0.0, 5.0) = 1.5;
uniform float ring_density : hint_range(1.0, 30.0) = 10.0;
uniform float glow_strength : hint_range(0.0, 3.0) = 1.4;
uniform float noise_strength : hint_range(0.0, 1.0) = 0.35;
uniform float edge_softness : hint_range(0.0, 0.5) = 0.25;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

float value_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	float a = hash(i);
	float b = hash(i + vec2(1.0, 0.0));
	float c = hash(i + vec2(0.0, 1.0));
	float d = hash(i + vec2(1.0, 1.0));
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}

void fragment() {
	vec2 centered = UV - vec2(0.5);
	float radius = length(centered) * 2.0;
	float angle = atan(centered.y, centered.x);

	angle += radius * 3.0 + TIME * swirl_speed;
	vec2 swirl_uv = vec2(cos(angle), sin(angle)) * radius;

	float n = value_noise(swirl_uv * 4.0 + TIME * 0.3) * noise_strength;

	float rings = sin((radius + n) * ring_density - TIME * ring_speed) * 0.5 + 0.5;

	float outer_mask = smoothstep(1.0, 1.0 - edge_softness, radius);
	float inner_mask = smoothstep(0.0, 0.2, radius);

	float intensity = rings * inner_mask * outer_mask;

	vec3 col = mix(color_core.rgb, color_edge.rgb, clamp(radius, 0.0, 1.0));

	float rim = smoothstep(0.6, 1.0, radius) * outer_mask;
	col += color_edge.rgb * rim * 0.9;

	ALBEDO = col;
	ALPHA = clamp(intensity * glow_strength, 0.0, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="Mat_portal"]
shader = SubResource("Shader_portal")
